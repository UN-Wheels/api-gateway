# Puerto en el que escucha el gateway
PORT=8080

# Clave secreta para verificar JWT (debe ser igual en loggueo_service)
JWT_SECRET=

# URLs de los microservicios
AUTH_SERVICE_URL=http://localhost:8000
CHAT_SERVICE_URL=http://localhost:3001
ROUTES_SERVICE_URL=

# Duración de la cookie en segundos (1800 = 30 minutos)
COOKIE_MAX_AGE=1800

# Origen permitido del frontend
FRONTEND_URL=http://localhost:5173
